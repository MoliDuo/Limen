{
  "name": "limen",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --import tsx --import ./tests/setup.ts --test tests/*.test.ts tests/*.test.mjs",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "crypto": "tsx scripts/crypto.ts"
  },
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "24.x"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiangyumou/Limen.git"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/xiangyumou/Limen/issues"
  },
  "homepage": "https://github.com/xiangyumou/Limen#readme",
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.7.0",
    "nanoid": "^6.0.0",
    "next": "^16.2.10",
    "openai": "^6.33.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "swr": "^2.4.2",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.2",
    "jsdom": "^29.1.1",
    "postcss": "8.5.28",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "postcss": "$postcss",
    "esbuild": "0.28.1",
    "sharp": "^0.35.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "sharp@0.35.3": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  }
}
